{
  "name": "gptree",
  "displayName": "GPTree",
  "version": "1.0.0",
  "description": "Conversation tree viewer for ChatGPT",
  "private": true,
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build --target=firefox-mv3",
    "package": "plasmo package --target=firefox-mv3"
  },
  "dependencies": {
    "plasmo": "0.89.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.5.0"
  },
  "manifest": {
    "host_permissions": [
      "https://chatgpt.com/*"
    ],
    "browser_specific_settings": {
      "gecko": {
        "id": "gptree@dev.local",
        "strict_min_version": "128.0"
      }
    }
  }
}
