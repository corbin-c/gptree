{
  "name": "gptree",
  "displayName": "GPTree",
  "version": "1.0.0",
  "description": "Conversation tree viewer for ChatGPT",
  "private": true,
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build --target=firefox-mv3",
    "package": "plasmo package --target=firefox-mv3"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.2",
    "dagre": "^0.8.5",
    "plasmo": "^0.90.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.54",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.5.0"
  },
  "manifest": {
    "host_permissions": [
      "https://chatgpt.com/*"
    ],
    "sidebar_action": {
      "default_title": "GPTree",
      "default_panel": "tabs/tree.html"
    },
    "browser_specific_settings": {
      "gecko": {
        "id": "gptree@dev.local",
        "strict_min_version": "128.0"
      }
    }
  }
}
